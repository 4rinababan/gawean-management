@page "/{Slug}/settings"
@rendermode InteractiveServer
@layout OrgLayout
@attribute [Authorize]
@inherits OrgPageBase
@inject OrganizationService Organizations
@inject ToastService Toasts

<PageTitle>Workspace settings</PageTitle>

<PageHeader Title="Workspace settings" Subtitle="Only workspace admins can change these." />

@if (!TenantReady)
{
    <div class="flex justify-center py-16"><Spinner Class="h-8 w-8 text-brand-500" /></div>
}
else if (!CanManage)
{
    <EmptyState Icon="lock-closed" Title="Admins only"
                Description="Ask a workspace admin to change these settings.">
        <Actions><a href="@($"/{Slug}")"><Button Variant="Button.ButtonVariant.Secondary">Back to overview</Button></a></Actions>
    </EmptyState>
}
else
{
    <Card Class="max-w-xl">
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="WarnInvalid">
            <DataAnnotationsValidator />
            <div class="space-y-4">
                <Field Label="Workspace name" Required>
                    <InputText @bind-Value="_form.Name" class="tm-input" />
                    <ValidationMessage For="() => _form.Name" class="mt-1 block text-xs text-rose-500" />
                </Field>
                <Field Label="Workspace URL">
                    <input class="tm-input" value="@($"/{Slug}")" disabled />
                    <p class="mt-1 text-xs text-slate-400">The URL is fixed — links your team has saved depend on it.</p>
                </Field>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <a href="@($"/{Slug}")"><Button Variant="Button.ButtonVariant.Secondary">Cancel</Button></a>
                <Button Type="submit" Loading="_busy">Save changes</Button>
            </div>
        </EditForm>
    </Card>

    <Card Class="mt-6 max-w-xl">
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Members</h3>
        <p class="mt-1 text-sm text-slate-500">Invite people and manage their roles on the members page.</p>
        <div class="mt-4"><a href="@($"/{Slug}/members")"><Button Variant="Button.ButtonVariant.Secondary">Manage members</Button></a></div>
    </Card>

    <Card Class="mt-6 max-w-xl border-rose-200 dark:border-rose-900">
        <h3 class="text-sm font-semibold text-rose-700 dark:text-rose-400">Delete this workspace</h3>
        <p class="mt-1 text-sm text-slate-500">
            Every project, issue, sprint, comment and attachment in <strong>@_form.Name</strong> is removed
            for all @(_memberCount) member@(_memberCount == 1 ? "" : "s"). This cannot be undone.
        </p>
        <div class="mt-4">
            <Button Variant="Button.ButtonVariant.Danger" Icon="trash" OnClick="BeginDelete">Delete workspace</Button>
        </div>
    </Card>

    <Modal Open="_showDelete" OpenChanged="v => _showDelete = v" Title="Delete workspace" Width="sm">
        <p class="text-sm text-slate-600 dark:text-slate-300">
            This permanently deletes <strong>@_form.Name</strong> and everything inside it.
        </p>
        <Field Label="Type the workspace name to confirm" Class="mt-4">
            <input class="tm-input" placeholder="@_form.Name" @bind="_deleteConfirmation" @bind:event="oninput" />
        </Field>
        <div class="mt-6 flex justify-end gap-2">
            <Button Variant="Button.ButtonVariant.Secondary" OnClick="() => _showDelete = false">Cancel</Button>
            <Button Variant="Button.ButtonVariant.Danger" Loading="_busy"
                    Disabled="@(_deleteConfirmation.Trim() != _form.Name)" OnClick="DeleteAsync">
                Delete permanently
            </Button>
        </div>
    </Modal>
}

@code {
    private sealed class RenameForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(80, MinimumLength = 2)]
        public string Name { get; set; } = "";
    }

    private readonly RenameForm _form = new();
    private bool _busy;
    private bool _showDelete;
    private string _deleteConfirmation = "";
    private int _memberCount;

    private bool CanManage => TenantReady && RolePermissions.Allows(Tenant.Role, OrgPermission.ManageOrganization);

    protected override async Task OnTenantReadyAsync()
    {
        var mine = await Organizations.GetMyOrganizationsAsync();
        var current = mine.FirstOrDefault(o => o.Slug == Slug);
        _form.Name = current?.Name ?? "";
        _memberCount = current?.MemberCount ?? 0;
    }

    private void BeginDelete()
    {
        _deleteConfirmation = "";
        _showDelete = true;
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Organizations.DeleteAsync(_deleteConfirmation);
            Toasts.Success($"Workspace \"{_form.Name}\" deleted.");
            Nav.NavigateTo("/", forceLoad: true); // the tenant this circuit resolved no longer exists
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private void WarnInvalid() => Toasts.Warning("Please fix the highlighted fields.");

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await Organizations.RenameAsync(_form.Name);
            Toasts.Success("Workspace renamed.");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }
}

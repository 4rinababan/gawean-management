@namespace TaskManagement.Web.Components.Pages.App
@using System.Text.Json.Serialization
@using TaskManagement.Domain.Wiki.Spreadsheet
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="space-y-2">
    @if (!ReadOnly)
    {
        <div class="flex flex-wrap items-center gap-1 border-b border-slate-200 pb-2 dark:border-slate-700">
            <button type="button" class="tm-page-nav" disabled="@(_lastActiveCell is null)" @onclick="CutAsync">Cut</button>
            <button type="button" class="tm-page-nav" disabled="@(_lastActiveCell is null)" @onclick="CopyAsync">Copy</button>
            <button type="button" class="tm-page-nav" disabled="@(_lastActiveCell is null)" @onclick="PasteAsync">Paste</button>
            <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
            <button type="button" class="@FormatToggleClass(CurrentFormat().Bold)" disabled="@(_lastActiveCell is null)" @onclick="ToggleBold" title="Bold"><strong>B</strong></button>
            <button type="button" class="@FormatToggleClass(CurrentFormat().Italic)" disabled="@(_lastActiveCell is null)" @onclick="ToggleItalic" title="Italic"><em>I</em></button>
            <button type="button" class="@FormatToggleClass(CurrentFormat().Underline)" disabled="@(_lastActiveCell is null)" @onclick="ToggleUnderline" title="Underline"><span class="underline">U</span></button>
            <label class="tm-page-nav cursor-pointer p-0.5" title="Text colour">
                <input type="color" class="h-5 w-5 cursor-pointer border-0 bg-transparent p-0" disabled="@(_lastActiveCell is null)"
                       value="@(CurrentFormat().TextColor ?? "#1e293b")" @onchange="e => SetTextColor(e.Value?.ToString())" />
            </label>
            <label class="tm-page-nav cursor-pointer p-0.5" title="Fill colour">
                <span class="text-[10px]">Fill</span>
                <input type="color" class="h-5 w-5 cursor-pointer border-0 bg-transparent p-0" disabled="@(_lastActiveCell is null)"
                       value="@(CurrentFormat().BackgroundColor ?? "#ffffff")" @onchange="e => SetBackgroundColor(e.Value?.ToString())" />
            </label>
            <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
            <button type="button" class="@FormatToggleClass(CurrentFormat().Align == "left")" disabled="@(_lastActiveCell is null)" @onclick='() => SetAlign("left")' title="Align left">L</button>
            <button type="button" class="@FormatToggleClass(CurrentFormat().Align == "center")" disabled="@(_lastActiveCell is null)" @onclick='() => SetAlign("center")' title="Align center">C</button>
            <button type="button" class="@FormatToggleClass(CurrentFormat().Align == "right")" disabled="@(_lastActiveCell is null)" @onclick='() => SetAlign("right")' title="Align right">R</button>
            <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
            <button type="button" class="tm-page-nav" disabled="@(_lastActiveCell is null)" @onclick="AutoSum" title="Sum the non-empty cells above">Σ AutoSum</button>
            <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
            <button type="button" class="tm-page-nav" @onclick="() => InsertRow(before: true)" title="Insert row above the selected cell">+Row ↑</button>
            <button type="button" class="tm-page-nav" @onclick="() => InsertRow(before: false)" title="Insert row below the selected cell">+Row ↓</button>
            <button type="button" class="tm-page-nav" disabled="@(ActiveSheet.RowCount <= 1)" @onclick="DeleteRow" title="Delete the selected cell's row">−Row</button>
            <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
            <button type="button" class="tm-page-nav" @onclick="() => InsertColumn(before: true)" title="Insert column left of the selected cell">+Col ←</button>
            <button type="button" class="tm-page-nav" @onclick="() => InsertColumn(before: false)" title="Insert column right of the selected cell">+Col →</button>
            <button type="button" class="tm-page-nav" disabled="@(ActiveSheet.ColumnCount <= 1)" @onclick="DeleteColumn" title="Delete the selected cell's column">−Col</button>
            <span class="mx-1 h-4 w-px bg-slate-200 dark:bg-slate-700"></span>
            <button type="button" class="tm-page-nav" disabled="@(_lastActiveCell is null)" @onclick="ClearActiveCellAsync" title="Clear value and formatting">Clear</button>
        </div>
    }

    <div class="overflow-auto rounded-lg border border-slate-200 dark:border-slate-700" style="max-height: 32rem">
        <table class="border-collapse text-sm">
            <thead>
                <tr>
                    <th class="sticky top-0 left-0 z-20 w-10 border border-slate-200 bg-slate-100 dark:border-slate-700 dark:bg-slate-800"></th>
                    @for (var c = 0; c < ActiveSheet.ColumnCount; c++)
                    {
                        <th class="sticky top-0 z-10 min-w-[6rem] border border-slate-200 bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400" @key="c">
                            @CellReference.IndexToColumn(c)
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var r = 0; r < ActiveSheet.RowCount; r++)
                {
                    var row = r;
                    <tr @key="row">
                        <th class="sticky left-0 z-10 border border-slate-200 bg-slate-100 px-2 py-1 text-right text-xs font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                            @(row + 1)
                        </th>
                        @for (var c = 0; c < ActiveSheet.ColumnCount; c++)
                        {
                            var cellRef = CellReference.ToReference(c, row);
                            <td class="border border-slate-200 p-0 dark:border-slate-700" @key="cellRef">
                                @if (!ReadOnly && _activeCell == cellRef)
                                {
                                    <input @ref="_activeInputRef" class="h-7 w-full min-w-[6rem] border-0 bg-white px-1.5 text-sm outline-none ring-1 ring-brand-500 dark:bg-slate-900 dark:text-slate-100"
                                           value="@GetRawValue(cellRef)"
                                           @onchange="e => SetCellValue(cellRef, e.Value?.ToString())"
                                           @onblur="() => _activeCell = null" />
                                }
                                else
                                {
                                    var value = FormulaEngine.Evaluate(cellRef, ActiveSheet);
                                    <div class="@($"h-7 min-w-[6rem] truncate px-1.5 py-1 leading-5 {CellFormatClass(cellRef)} {(!ReadOnly ? "cursor-cell hover:bg-slate-50 dark:hover:bg-slate-800" : "")} {(!ReadOnly && _activeCell is null && _lastActiveCell == cellRef ? "ring-1 ring-inset ring-brand-300" : "")} {(value.IsError ? "text-rose-600 dark:text-rose-400" : "text-slate-700 dark:text-slate-200")}")"
                                         style="@CellInlineStyle(cellRef)"
                                         @onclick="() => Activate(cellRef)">
                                        @value.ToString()
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!ReadOnly)
    {
        <div class="flex items-center gap-2">
            <Button Variant="Button.ButtonVariant.Secondary" OnClick="AddRow">+ Row</Button>
            <Button Variant="Button.ButtonVariant.Secondary" OnClick="AddColumn">+ Column</Button>
        </div>
    }

    <div class="flex flex-wrap items-center gap-1 border-t border-slate-200 pt-2 dark:border-slate-700">
        @for (var i = 0; i < Workbook.Sheets.Count; i++)
        {
            var index = i;
            <div class="group relative">
                <button type="button" class="@SheetTabClass(index)" @onclick="() => _activeSheetIndex = index">
                    @Workbook.Sheets[index].Name
                    @if (!ReadOnly && Workbook.Sheets.Count > 1)
                    {
                        <span class="ml-1.5 text-slate-400 hover:text-rose-500" @onclick="() => RemoveSheet(index)" @onclick:stopPropagation="true">✕</span>
                    }
                </button>
            </div>
        }
        @if (!ReadOnly)
        {
            <button type="button" class="rounded-full p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800" title="Add sheet" @onclick="AddSheet">
                <Icon Name="plus" Class="h-4 w-4" />
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SpreadsheetWorkbook Workbook { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private int _activeSheetIndex;
    private string? _activeCell;
    private string? _lastActiveCell;
    private ElementReference? _activeInputRef;
    private bool _focusPending;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SpreadsheetEditor>? _ref;

    private SpreadsheetSheet ActiveSheet => Workbook.Sheets[Math.Clamp(_activeSheetIndex, 0, Workbook.Sheets.Count - 1)];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _activeInputRef is { } input)
        {
            _focusPending = false;
            try
            {
                await input.FocusAsync();
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/spreadsheet.js");
                _ref ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("attachPasteListener", input, _ref);
            }
            catch (JSDisconnectedException) { }
        }
    }

    private string GetRawValue(string cellRef) => ActiveSheet.Cells.TryGetValue(cellRef, out var v) ? v : "";

    private void Activate(string cellRef)
    {
        if (ReadOnly) return;
        _activeCell = cellRef;
        _lastActiveCell = cellRef;
        _focusPending = true;
    }

    private async Task SetCellValue(string cellRef, string? value)
    {
        if (string.IsNullOrEmpty(value))
            ActiveSheet.Cells.Remove(cellRef);
        else
            ActiveSheet.Cells[cellRef] = value;
        _activeCell = null;
        await OnChanged.InvokeAsync();
    }

    private async Task AddRow()
    {
        ActiveSheet.RowCount++;
        await OnChanged.InvokeAsync();
    }

    private async Task AddColumn()
    {
        ActiveSheet.ColumnCount++;
        await OnChanged.InvokeAsync();
    }

    private async Task AddSheet()
    {
        var n = Workbook.Sheets.Count + 1;
        Workbook.Sheets.Add(new SpreadsheetSheet { Name = $"Sheet{n}" });
        _activeSheetIndex = Workbook.Sheets.Count - 1;
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveSheet(int index)
    {
        if (Workbook.Sheets.Count <= 1) return;
        Workbook.Sheets.RemoveAt(index);
        _activeSheetIndex = Math.Clamp(_activeSheetIndex, 0, Workbook.Sheets.Count - 1);
        await OnChanged.InvokeAsync();
    }

    private string SheetTabClass(int index) =>
        "rounded-t-lg border border-b-0 px-3 py-1.5 text-xs font-medium transition " +
        (index == _activeSheetIndex
            ? "border-slate-200 bg-white text-brand-700 dark:border-slate-700 dark:bg-slate-900 dark:text-brand-300"
            : "border-transparent text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800");

    // --- Formatting: render + toolbar -------------------------------------------------------------

    private CellFormat CurrentFormat() =>
        _lastActiveCell is { } cell && ActiveSheet.Formats.TryGetValue(cell, out var f) ? f : new CellFormat();

    private string CellInlineStyle(string cellRef)
    {
        if (!ActiveSheet.Formats.TryGetValue(cellRef, out var f) || f.IsEmpty) return "";
        var parts = new List<string>();
        if (f.BackgroundColor is not null) parts.Add($"background-color:{f.BackgroundColor}");
        if (f.TextColor is not null) parts.Add($"color:{f.TextColor}");
        return string.Join(';', parts);
    }

    private string CellFormatClass(string cellRef)
    {
        if (!ActiveSheet.Formats.TryGetValue(cellRef, out var f) || f.IsEmpty) return "";
        return string.Join(' ', new[]
        {
            f.Bold ? "font-bold" : "",
            f.Italic ? "italic" : "",
            f.Underline ? "underline" : "",
            f.Align switch { "center" => "text-center", "right" => "text-right", _ => "" },
        }.Where(c => c.Length > 0));
    }

    private static string FormatToggleClass(bool active) =>
        "tm-page-nav w-7" + (active ? " !border-brand-400 !bg-brand-50 !text-brand-700 dark:!bg-brand-500/10 dark:!text-brand-300" : "");

    private async Task MutateFormat(Action<CellFormat> mutate)
    {
        if (_lastActiveCell is not { } cellRef) return;
        var format = ActiveSheet.Formats.TryGetValue(cellRef, out var existing) ? existing : new CellFormat();
        mutate(format);
        if (format.IsEmpty) ActiveSheet.Formats.Remove(cellRef);
        else ActiveSheet.Formats[cellRef] = format;
        await OnChanged.InvokeAsync();
    }

    private Task ToggleBold() => MutateFormat(f => f.Bold = !f.Bold);
    private Task ToggleItalic() => MutateFormat(f => f.Italic = !f.Italic);
    private Task ToggleUnderline() => MutateFormat(f => f.Underline = !f.Underline);
    private Task SetAlign(string align) => MutateFormat(f => f.Align = f.Align == align ? null : align);
    private Task SetTextColor(string? color) => MutateFormat(f => f.TextColor = color);
    private Task SetBackgroundColor(string? color) => MutateFormat(f => f.BackgroundColor = color);

    /// <summary>Sums the contiguous non-empty cells directly above the selected cell — the common
    /// "select a cell under a column of numbers, click AutoSum" flow. Does nothing if the cell above
    /// is empty, since there's no sensible range to guess at.</summary>
    private async Task AutoSum()
    {
        if (_lastActiveCell is not { } cell || !CellReference.TryParse(cell, out var col, out var row) || row == 0)
            return;

        var endRow = row - 1;
        if (!ActiveSheet.Cells.ContainsKey(CellReference.ToReference(col, endRow))) return;

        var startRow = endRow;
        while (startRow > 0 && ActiveSheet.Cells.ContainsKey(CellReference.ToReference(col, startRow - 1)))
            startRow--;

        ActiveSheet.Cells[cell] = startRow == endRow
            ? $"=SUM({CellReference.ToReference(col, startRow)})"
            : $"=SUM({CellReference.ToReference(col, startRow)}:{CellReference.ToReference(col, endRow)})";
        await OnChanged.InvokeAsync();
    }

    // --- Clipboard: paste from Excel, preserving colour/bold/merged-header formatting -------------

    /// <summary>A cell as parsed by spreadsheet.js — either from Excel's rich text/html clipboard
    /// payload (colour, bold, alignment, merged headers flattened into a formatted band) or, when no
    /// table markup is on the clipboard, a plain value with every format flag left at its default.</summary>
    public sealed class PastedCellData
    {
        [JsonPropertyName("value")] public string Value { get; set; } = "";
        [JsonPropertyName("bold")] public bool Bold { get; set; }
        [JsonPropertyName("italic")] public bool Italic { get; set; }
        [JsonPropertyName("underline")] public bool Underline { get; set; }
        [JsonPropertyName("backgroundColor")] public string? BackgroundColor { get; set; }
        [JsonPropertyName("textColor")] public string? TextColor { get; set; }
        [JsonPropertyName("align")] public string? Align { get; set; }
    }

    /// <summary>Called from spreadsheet.js when a multi-cell paste (Excel's rich HTML clipboard, or a
    /// plain tab/newline-delimited fallback) is intercepted on the active cell's input. Fans the pasted
    /// grid out starting at that cell, growing the sheet if the pasted block runs past its current bounds.</summary>
    [JSInvokable]
    public async Task OnGridPasted(PastedCellData[][] grid)
    {
        var anchor = _lastActiveCell ?? _activeCell;
        if (anchor is null || grid.Length == 0 || !CellReference.TryParse(anchor, out var startCol, out var startRow))
            return;

        var maxRow = startRow + grid.Length - 1;
        var maxCol = startCol + grid.Max(r => r.Length) - 1;
        if (maxRow >= ActiveSheet.RowCount) ActiveSheet.RowCount = maxRow + 1;
        if (maxCol >= ActiveSheet.ColumnCount) ActiveSheet.ColumnCount = maxCol + 1;

        for (var r = 0; r < grid.Length; r++)
        {
            for (var c = 0; c < grid[r].Length; c++)
            {
                var cellRef = CellReference.ToReference(startCol + c, startRow + r);
                var cell = grid[r][c];

                if (string.IsNullOrEmpty(cell.Value)) ActiveSheet.Cells.Remove(cellRef);
                else ActiveSheet.Cells[cellRef] = cell.Value;

                var format = new CellFormat
                {
                    Bold = cell.Bold,
                    Italic = cell.Italic,
                    Underline = cell.Underline,
                    BackgroundColor = cell.BackgroundColor,
                    TextColor = cell.TextColor,
                    Align = cell.Align,
                };
                if (format.IsEmpty) ActiveSheet.Formats.Remove(cellRef);
                else ActiveSheet.Formats[cellRef] = format;
            }
        }

        _activeCell = null;
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>Toolbar Paste button — an alternative to Ctrl+V for when the active cell doesn't have
    /// native paste focus (e.g. right after clicking Paste itself). Uses the async Clipboard API.</summary>
    private async Task PasteAsync()
    {
        if (_lastActiveCell is null) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/spreadsheet.js");
        var grid = await _module.InvokeAsync<PastedCellData[][]?>("readClipboardGrid");
        if (grid is { Length: > 0 })
            await OnGridPasted(grid);
    }

    /// <summary>Copies the raw value only — pasting this back into Excel round-trips the text, not the
    /// cell's colour/bold formatting (writing a matching text/html clipboard payload back out is a
    /// separate, not-yet-built piece of this feature).</summary>
    private async Task CopyAsync()
    {
        if (_lastActiveCell is not { } cellRef) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/spreadsheet.js");
        await _module.InvokeVoidAsync("writeClipboardText", GetRawValue(cellRef));
    }

    private async Task CutAsync()
    {
        if (_lastActiveCell is not { } cellRef) return;
        await CopyAsync();
        ActiveSheet.Cells.Remove(cellRef);
        ActiveSheet.Formats.Remove(cellRef);
        await OnChanged.InvokeAsync();
    }

    private async Task ClearActiveCellAsync()
    {
        if (_lastActiveCell is not { } cellRef) return;
        ActiveSheet.Cells.Remove(cellRef);
        ActiveSheet.Formats.Remove(cellRef);
        await OnChanged.InvokeAsync();
    }

    // --- Structural edits: insert/delete row or column, re-keying every affected cell -----------

    private async Task InsertRow(bool before)
    {
        var atRow = _lastActiveCell is { } cell && CellReference.TryParse(cell, out _, out var row) ? row : 0;
        var insertAt = before ? atRow : atRow + 1;
        ActiveSheet.Cells = ShiftCells(ActiveSheet.Cells, insertRowAt: insertAt);
        ActiveSheet.Formats = ShiftCells(ActiveSheet.Formats, insertRowAt: insertAt);
        ActiveSheet.RowCount++;
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteRow()
    {
        if (ActiveSheet.RowCount <= 1) return;
        var atRow = _lastActiveCell is { } cell && CellReference.TryParse(cell, out _, out var row) ? row : 0;
        ActiveSheet.Cells = ShiftCells(ActiveSheet.Cells, removeRow: atRow);
        ActiveSheet.Formats = ShiftCells(ActiveSheet.Formats, removeRow: atRow);
        ActiveSheet.RowCount--;
        await OnChanged.InvokeAsync();
    }

    private async Task InsertColumn(bool before)
    {
        var atCol = _lastActiveCell is { } cell && CellReference.TryParse(cell, out var col, out _) ? col : 0;
        var insertAt = before ? atCol : atCol + 1;
        ActiveSheet.Cells = ShiftCells(ActiveSheet.Cells, insertColAt: insertAt);
        ActiveSheet.Formats = ShiftCells(ActiveSheet.Formats, insertColAt: insertAt);
        ActiveSheet.ColumnCount++;
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteColumn()
    {
        if (ActiveSheet.ColumnCount <= 1) return;
        var atCol = _lastActiveCell is { } cell && CellReference.TryParse(cell, out var col, out _) ? col : 0;
        ActiveSheet.Cells = ShiftCells(ActiveSheet.Cells, removeCol: atCol);
        ActiveSheet.Formats = ShiftCells(ActiveSheet.Formats, removeCol: atCol);
        ActiveSheet.ColumnCount--;
        await OnChanged.InvokeAsync();
    }

    /// <summary>Rebuilds a cell dictionary (values, or formats — both keyed the same way) with every
    /// reference re-keyed for one row/column insert or removal. Only one of the four operations is
    /// ever passed at a time.</summary>
    private static Dictionary<string, T> ShiftCells<T>(
        Dictionary<string, T> cells,
        int? removeRow = null, int? insertRowAt = null,
        int? removeCol = null, int? insertColAt = null)
    {
        var result = new Dictionary<string, T>();
        foreach (var (key, value) in cells)
        {
            if (!CellReference.TryParse(key, out var col, out var row)) continue;

            if (removeRow is { } rr)
            {
                if (row == rr) continue;
                if (row > rr) row--;
            }
            if (insertRowAt is { } ir && row >= ir) row++;

            if (removeCol is { } rc)
            {
                if (col == rc) continue;
                if (col > rc) col--;
            }
            if (insertColAt is { } ic && col >= ic) col++;

            result[CellReference.ToReference(col, row)] = value;
        }
        return result;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _ref?.Dispose();
    }
}

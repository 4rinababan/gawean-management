@namespace TaskManagement.Web.Components.Pages.App
@inject IssueService Issues
@inject OrganizationService Organizations
@inject ToastService Toasts
@inject IAiAssistant Ai

<Modal Open="Open" OpenChanged="OpenChanged" Title="Create issue">
    @if (Ai.IsEnabled)
    {
        @* Outside the EditForm on purpose: this is a drafting aid, not a field, and pressing Enter
           here must fill the form rather than submit it. *@
        <div class="mb-4 rounded-lg border border-brand-200 bg-brand-50/60 p-3 dark:border-brand-900 dark:bg-brand-950/40">
            <label class="tm-label" for="ai-prompt">Describe it in one line</label>
            <div class="flex gap-2">
                <input id="ai-prompt" class="tm-input" @bind="_aiPrompt" @bind:event="oninput"
                       @onkeydown="OnPromptKeyDown" disabled="@_drafting"
                       placeholder="e.g. user tidak bisa upload attachment lebih dari 10MB di Safari" />
                <Button Variant="Button.ButtonVariant.Secondary" OnClick="DraftAsync"
                        Loading="_drafting" Disabled="@(string.IsNullOrWhiteSpace(_aiPrompt))">
                    <Icon Name="sparkles" Class="h-4 w-4" /> Draft
                </Button>
            </div>
            <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
                Fills the fields below with a suggestion. Review it before creating — the model can be wrong.
            </p>
        </div>
    }

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" OnInvalidSubmit="WarnInvalid">
        <FluentValidationValidator />
        <div class="space-y-4">
            <Field Label="Summary" Required>
                <InputText @bind-Value="_form.Title" class="tm-input" placeholder="Short, descriptive title" />
                <ValidationMessage For="() => _form.Title" class="mt-1 block text-xs text-rose-500" />
            </Field>
            <div class="grid grid-cols-2 gap-3">
                <Field Label="Type">
                    <InputSelect @bind-Value="_form.Type" class="tm-select">
                        @foreach (var t in Enum.GetValues<IssueType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </Field>
                <Field Label="Priority">
                    <InputSelect @bind-Value="_form.Priority" class="tm-select">
                        @foreach (var p in Enum.GetValues<IssuePriority>())
                        {
                            <option value="@p">@p</option>
                        }
                    </InputSelect>
                </Field>
            </div>
            <Field Label="Description">
                @* Same editor as the issue page, so an AI draft arrives formatted rather than as raw tags. *@
                <RichTextEditor Value="@_form.Description" ValueChanged="v => _form.Description = v" />
            </Field>
            <div class="grid grid-cols-2 gap-3">
                <Field Label="Assignee">
                    <UserPicker Members="_members" @bind-Value="_form.AssigneeUserId" />
                </Field>
                <Field Label="Story points">
                    <InputNumber @bind-Value="_form.StoryPoints" class="tm-input" />
                </Field>
            </div>
            <Field Label="Due date" Hint="Overdue tasks are flagged on your dashboard.">
                <InputDate @bind-Value="_form.DueDate" class="tm-input" />
            </Field>
        </div>
        <div class="mt-6 flex justify-end gap-2">
            <Button Variant="Button.ButtonVariant.Secondary" OnClick="() => OpenChanged.InvokeAsync(false)">Cancel</Button>
            <Button Type="submit" Loading="_busy">Create</Button>
        </div>
    </EditForm>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? SprintId { get; set; }
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    private CreateIssueRequest _form = new();
    private IReadOnlyList<OrganizationMemberDto> _members = [];
    private bool _busy;
    private string? _aiPrompt;
    private bool _drafting;

    protected override async Task OnParametersSetAsync()
    {
        // The validator requires ProjectId, and validation runs *before* OnValidSubmit — so these must be
        // on the model as soon as it is bound, not assigned inside the submit handler.
        _form.ProjectId = ProjectId;
        _form.SprintId = SprintId;

        if (Open && _members.Count == 0)
            _members = await Organizations.GetMembersAsync();
    }

    private void WarnInvalid() => Toasts.Warning("Please fix the highlighted fields.");

    private async Task OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DraftAsync();
    }

    /// <summary>
    /// Fills the form from a model suggestion. Deliberately does not create anything: the author still
    /// reviews every field and presses Create, so a bad draft costs a moment rather than a bad ticket.
    /// </summary>
    private async Task DraftAsync()
    {
        if (_drafting || string.IsNullOrWhiteSpace(_aiPrompt)) return;

        _drafting = true;
        try
        {
            var draft = await Ai.DraftIssueAsync(_aiPrompt);

            _form.Title = draft.Title;
            _form.Description = draft.Description;
            _form.Type = draft.Type;
            _form.Priority = draft.Priority;
            _form.StoryPoints = draft.StoryPoints;

            Toasts.Show("Draft ready — review it before creating.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            _drafting = false;
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var id = await Issues.CreateAsync(_form);
            Toasts.Success("Issue created.");
            _form = new CreateIssueRequest { ProjectId = ProjectId, SprintId = SprintId };
            await OpenChanged.InvokeAsync(false);
            await OnCreated.InvokeAsync(id);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }
}

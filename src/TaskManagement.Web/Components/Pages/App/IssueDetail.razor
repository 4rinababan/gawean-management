@page "/{Slug}/issues/{IssueId:guid}"
@using System.Text
@using System.Text.Encodings.Web
@using TaskManagement.Application.Services
@rendermode InteractiveServer
@layout OrgLayout
@attribute [Authorize]
@inherits OrgPageBase
@inject IssueService Issues
@inject AttachmentService Attachments
@inject OrganizationService Organizations
@inject SprintService SprintSvc
@inject ProjectService Projects
@inject ToastService Toasts
@inject ICurrentUser CurrentUser
@inject IAiAssistant Ai

<PageTitle>@(_issue?.Reference ?? "Issue")</PageTitle>

@if (_issue is null)
{
    <div class="flex justify-center py-16"><Spinner Class="h-8 w-8 text-brand-500" /></div>
}
else
{
    <PageHeader Title="@_issue.Title">
        <Breadcrumb>
            <a href="@($"/{Slug}/projects/{_issue.ProjectKey}/board")" class="hover:underline">@_issue.ProjectKey</a>
            <span class="mx-1">/</span>
            <span class="font-mono">@_issue.Reference</span>
        </Breadcrumb>
        <Actions>
            @if (CanDelete)
            {
                <Button Variant="Button.ButtonVariant.Danger" Icon="trash" OnClick="() => _confirmDelete = true">Delete</Button>
            }
        </Actions>
    </PageHeader>

    <div class="grid gap-6 lg:grid-cols-[1fr_300px]">
        <div class="space-y-6">
            <Card>
                <Field Label="Summary">
                    <input class="tm-input" @bind="_edit.Title" @bind:event="oninput" disabled="@(!CanEditReporterFields)" />
                </Field>
                @* Descriptions carry queries and diagrams, so the default is the rendered document —
                   code highlighted, ERDs drawn — and editing is an explicit mode. *@
                <div class="mt-4 flex items-center justify-between">
                    <span class="tm-label mb-0">Description</span>
                    @if (CanEditGeneral && !_editingDescription)
                    {
                        <Button Variant="Button.ButtonVariant.Secondary" OnClick="() => _editingDescription = true">Edit</Button>
                    }
                </div>

                @if (_editingDescription)
                {
                    <RichTextEditor Value="@_edit.Description" ValueChanged="OnDescriptionChanged"
                                    OnUploadImage="UploadInlineImageAsync" />
                    <div class="mt-4 flex items-center justify-end gap-3">
                        @if (IsDirty)
                        {
                            <span class="text-xs text-amber-600">Unsaved changes</span>
                        }
                        <Button Variant="Button.ButtonVariant.Secondary" OnClick="CancelDescriptionEdit">Cancel</Button>
                        <Button Type="button" Loading="_saving" OnClick="SaveDetailsAsync">Save changes</Button>
                    </div>
                }
                else
                {
                    <div class="mt-1"><RichTextView Html="@_issue.Description" /></div>
                    @if (CanEditReporterFields && _edit.Title != _issue.Title)
                    {
                        <div class="mt-4 flex items-center justify-end gap-3">
                            <span class="text-xs text-amber-600">Unsaved changes</span>
                            <Button Variant="Button.ButtonVariant.Secondary" OnClick="ResetEdits">Discard</Button>
                            <Button Type="button" Loading="_saving" OnClick="SaveDetailsAsync">Save changes</Button>
                        </div>
                    }
                }
            </Card>

            @if (Ai.IsEnabled)
            {
                <Card Header="@AskAiHeader">
                    <div class="flex gap-2">
                        <input class="tm-input" @bind="_aiQuestion" @bind:event="oninput" disabled="@_asking"
                               placeholder="e.g. jelaskan detail requirement export mapping-nya" />
                        <Button Variant="Button.ButtonVariant.Secondary" OnClick="AskAiAsync" Loading="_asking"
                                Disabled="@(string.IsNullOrWhiteSpace(_aiQuestion))">
                            <Icon Name="sparkles" Class="h-4 w-4" /> Ask
                        </Button>
                    </div>

                    @if (_aiAnswerHtml is not null)
                    {
                        <div class="mt-3 rounded-lg border border-brand-200 bg-brand-50/60 p-3 dark:border-brand-900 dark:bg-brand-950/40">
                            <RichTextView Html="@_aiAnswerHtml" />
                            <div class="mt-3 flex justify-end gap-2">
                                <Button Variant="Button.ButtonVariant.Secondary" OnClick="AskAiAsync" Loading="_asking">Regenerate</Button>
                                <Button Loading="_savingNote" OnClick="SaveAiNoteAsync">Save</Button>
                            </div>
                        </div>
                    }

                    @if (_issue.AiNotes.Count > 0)
                    {
                        <div class="mt-4 space-y-3">
                            @foreach (var note in _issue.AiNotes)
                            {
                                <div class="rounded-lg border border-slate-100 p-3 dark:border-slate-800" @key="note.Id">
                                    <p class="text-xs text-slate-400">"@note.Question" — asked by @note.AskedByDisplayName, @note.CreatedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</p>
                                    <div class="mt-1"><RichTextView Html="@note.Answer" /></div>
                                </div>
                            }
                        </div>
                    }
                </Card>
            }

            <Card Header="@CommentsHeader">
                @foreach (var c in _issue.Comments)
                {
                    <div class="flex gap-3 py-3" @key="c.Id">
                        <Avatar Name="@c.AuthorDisplayName" Color="@c.AuthorAvatarColor" Size="sm" />
                        <div class="min-w-0 flex-1">
                            <p class="text-xs text-slate-400">@c.AuthorDisplayName · @c.CreatedAt.LocalDateTime.ToString("g")</p>
                            <p class="whitespace-pre-wrap text-sm text-slate-700 dark:text-slate-200">@RenderCommentBody(c.Body)</p>
                        </div>
                    </div>
                }
                @if (CanComment)
                {
                    <div class="mt-2 flex items-start gap-2">
                        @* The literal "@" has to come from an expression: a component attribute
                           cannot mix markup escapes with text. *@
                        <MentionTextArea @bind-Value="_newComment" Members="_members"
                                         Placeholder="@("Leave a comment… type @ to mention someone")" />
                        <Button Loading="_commenting" OnClick="AddCommentAsync">Send</Button>
                    </div>
                }
            </Card>

            <Card Header="@AttachmentsHeader">
                @if (_issue.Attachments.Count == 0)
                {
                    <p class="text-sm text-slate-400">No attachments.</p>
                }
                <ul class="space-y-1">
                    @foreach (var a in _issue.Attachments)
                    {
                        <li class="flex items-center justify-between gap-2 text-sm">
                            <a class="inline-flex min-w-0 items-center gap-1.5 text-brand-600 hover:underline" href="@($"/{Slug}/attachments/{a.Id}")" target="_blank">
                                <Icon Name="@IssueVisuals.AttachmentIcon(a.FileName)" Class="@($"h-4 w-4 shrink-0 {IssueVisuals.AttachmentIconColor(a.FileName)}")" />
                                <span class="truncate">@a.FileName</span>
                            </a>
                            <span class="flex shrink-0 items-center gap-2">
                                <span class="text-xs text-slate-400">@(a.SizeBytes / 1024) KB</span>
                                @if (a.UploadedByUserId == CurrentUser.UserId)
                                {
                                    <button type="button" class="text-slate-400 hover:text-rose-600 dark:hover:text-rose-400"
                                            title="Delete this attachment" aria-label="@($"Delete {a.FileName}")"
                                            @onclick="() => _confirmDeleteAttachmentId = a.Id">
                                        <Icon Name="trash" Class="h-4 w-4" />
                                    </button>
                                }
                            </span>
                        </li>
                    }
                </ul>
                <div class="mt-3 flex flex-col items-start gap-2">
                    @if (_issue.Attachments.Count > 1)
                    {
                        @* target="_blank" matters here, not just for a new tab: without it Blazor's enhanced
                           navigation intercepts the click and tries to treat the zip response as a page to
                           render, so the download silently never happens. *@
                        <a class="inline-flex items-center gap-1.5 text-xs font-medium text-brand-600 hover:underline"
                           href="@($"/{Slug}/attachments/issue/{IssueId}/zip")" target="_blank">
                            <Icon Name="archive-box" Class="h-3.5 w-3.5" /> Download all (.zip)
                        </a>
                    }
                    @if (CanEditStatus)
                    {
                        @* A label wrapping a hidden input is the accessible way to restyle a file picker —
                           clicking the label opens the dialog, and it stays keyboard reachable. *@
                        <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                            <Icon Name="paper-clip" Class="h-4 w-4" />
                            @(_uploading ? "Uploading…" : "Add attachment")
                            <InputFile OnChange="UploadAsync" class="sr-only" disabled="@_uploading" />
                        </label>
                    }
                </div>
            </Card>
        </div>

        <div class="space-y-4">
            <Card>
                <div class="space-y-4 text-sm">
                    <div>
                        <p class="tm-label">Status</p>
                        <select class="tm-select" disabled="@(!CanEditStatus)" @onchange="e => ChangeStatus(e.Value?.ToString())">
                            @foreach (var st in Enum.GetValues<IssueStatus>())
                            {
                                <option value="@st" selected="@(st == _issue.Status)">@IssueVisuals.StatusLabel(st)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <p class="tm-label">Assignee</p>
                        <UserPicker Members="_members" Value="@_issue.AssigneeUserId" ValueChanged="ChangeAssignee" />
                    </div>
                    <div>
                        <p class="tm-label">Viewers</p>
                        <UserMultiPicker Members="_members" Values="@_issue.Viewers.Select(v => v.UserId).ToList()"
                                         OnAdd="AddViewer" OnRemove="RemoveViewer" Placeholder="Add viewers" />
                    </div>
                    <div>
                        <p class="tm-label">Priority</p>
                        <select class="tm-select" disabled="@(!CanEditReporterFields)" @onchange="e => SaveField(() => _edit.Priority = Enum.Parse<IssuePriority>(e.Value!.ToString()!))">
                            @foreach (var p in Enum.GetValues<IssuePriority>())
                            {
                                <option value="@p" selected="@(p == _issue.Priority)">@p</option>
                            }
                        </select>
                    </div>
                    <div>
                        <p class="tm-label">Type</p>
                        <select class="tm-select" disabled="@(!CanEditGeneral)" @onchange="e => SaveField(() => _edit.Type = Enum.Parse<IssueType>(e.Value!.ToString()!))">
                            @foreach (var t in Enum.GetValues<IssueType>())
                            {
                                <option value="@t" selected="@(t == _issue.Type)">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <p class="tm-label">Due date</p>
                        <input type="date" class="tm-input" value="@_issue.DueDate?.ToString("yyyy-MM-dd")" disabled="@(!CanEditReporterFields)"
                               @onchange="e => SaveField(() => _edit.DueDate = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
                        @if (_issue.DueDate is { } due && _issue.Status != IssueStatus.Done && due < DateOnly.FromDateTime(DateTime.Today))
                        {
                            <p class="mt-1 text-xs font-semibold text-rose-600 dark:text-rose-400">⚠ Overdue since @due.ToString("MMM d")</p>
                        }
                    </div>
                    <div>
                        <p class="tm-label">Story points</p>
                        <input type="number" class="tm-input" value="@_issue.StoryPoints" disabled="@(!CanEditReporterFields)"
                               @onchange="e => SaveField(() => _edit.StoryPoints = int.TryParse(e.Value?.ToString(), out var v) ? v : null)" />
                    </div>
                    <div>
                        <p class="tm-label">Sprint</p>
                        <select class="tm-select" disabled="@(!CanEditGeneral)" @onchange="e => SaveField(() => _edit.SprintId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : null)">
                            <option value="">Backlog</option>
                            @foreach (var s in _sprints)
                            {
                                <option value="@s.Id" selected="@(s.Id == _issue.SprintId)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="flex items-center gap-2 border-t border-slate-100 pt-3 dark:border-slate-800">
                        <Avatar Name="@_issue.ReporterDisplayName" Color="@_issue.ReporterAvatarColor" Size="xs" />
                        <div class="text-xs text-slate-400">
                            <p>Reported by <span class="font-medium text-slate-600 dark:text-slate-300">@_issue.ReporterDisplayName</span></p>
                            <p>Created @_issue.CreatedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</p>
                        </div>
                    </div>
                </div>
            </Card>

            <Card Header="@ActivityHeader">
                @if (_issue.Activity.Count == 0)
                {
                    <p class="text-xs text-slate-400">No activity yet.</p>
                }
                <ol class="max-h-96 space-y-3 overflow-y-auto pr-1 text-xs text-slate-500">
                    @foreach (var a in _issue.Activity)
                    {
                        <li @key="a.Id">
                            <div>
                                <span class="font-medium text-slate-700 dark:text-slate-200">@a.ActorDisplayName</span>
                                @if (a.IsComment)
                                {
                                    <span> added a comment</span>
                                }
                                else if (a.OldLabel is null)
                                {
                                    <span> set <span class="font-medium">@a.FieldLabel</span> to “@(a.NewLabel ?? "—")”</span>
                                }
                                else if (a.NewLabel is null)
                                {
                                    <span> cleared the <span class="font-medium">@a.FieldLabel</span></span>
                                }
                                else
                                {
                                    <span> changed <span class="font-medium">@a.FieldLabel</span> to “@a.NewLabel”</span>
                                }
                            </div>
                            <time class="text-slate-400">@a.CreatedAt.LocalDateTime.ToString("d MMM, HH:mm")</time>
                        </li>
                    }
                </ol>
            </Card>
        </div>
    </div>

    <ConfirmDialog Open="_confirmDelete" OpenChanged="v => _confirmDelete = v" Destructive
                   Title="Delete issue" Message="@($"Delete {_issue.Reference}? This cannot be undone.")"
                   ConfirmText="Delete" OnConfirm="DeleteAsync" />

    <ConfirmDialog Open="_confirmDeleteAttachmentId is not null" OpenChanged="v => { if (!v) _confirmDeleteAttachmentId = null; }" Destructive
                   Title="Delete attachment" Message="Delete this file? This cannot be undone."
                   ConfirmText="Delete" OnConfirm="DeleteAttachmentAsync" />
}

@code {
    [Parameter] public Guid IssueId { get; set; }

    private IssueDetailDto? _issue;
    private IReadOnlyList<OrganizationMemberDto> _members = [];
    private IReadOnlyList<SprintDto> _sprints = [];
    private UpdateIssueRequest _edit = new();
    private string _newComment = "";
    private bool _commenting;
    private bool _saving;
    private bool _descriptionDirty;
    private bool _uploading;
    private bool _editingDescription;
    private bool _confirmDelete;
    private Guid? _confirmDeleteAttachmentId;
    private string? _aiQuestion;
    private string? _aiAnswerHtml;
    private bool _asking;
    private bool _savingNote;

    private RenderFragment AskAiHeader => @<span class="text-sm font-semibold">Ask GAWE AI</span>;
    private RenderFragment CommentsHeader => @<span class="text-sm font-semibold">Comments (@(_issue?.Comments.Count ?? 0))</span>;
    private RenderFragment ActivityHeader => @<span class="text-sm font-semibold">Activity</span>;
    private RenderFragment AttachmentsHeader => @<span class="text-sm font-semibold">Attachments</span>;

    private bool CanDelete => TenantReady && RolePermissions.Allows(Tenant.Role, OrgPermission.DeleteIssue);

    private bool IsReporter => _issue?.ReporterUserId == CurrentUser.UserId;
    private bool IsAssignee => _issue is not null && _issue.AssigneeUserId == CurrentUser.UserId;
    private bool IsIssueViewer => _issue?.Viewers.Any(v => v.UserId == CurrentUser.UserId) == true;

    /// <summary>Summary/priority/story points/due date are reserved for whoever reported the issue.</summary>
    private bool CanEditReporterFields => TenantReady && IsReporter;

    /// <summary>
    /// Description/type/sprint/assignee/viewers: the reporter, or an org admin — unless that admin is
    /// the assignee, in which case they're narrowed to status only like any other assignee.
    /// </summary>
    private bool CanEditGeneral => TenantReady && (IsReporter || (Tenant.Role == OrgRole.Admin && !IsAssignee));

    /// <summary>Status (and attachments) additionally open to the assignee, even a non-admin one.</summary>
    private bool CanEditStatus => CanEditGeneral || (TenantReady && IsAssignee);

    /// <summary>A listed viewer can always comment, even on the rare org-Viewer-role account that otherwise couldn't.</summary>
    private bool CanComment => TenantReady && (RolePermissions.Allows(Tenant.Role, OrgPermission.CommentOnIssue) || IsIssueViewer);

    protected override async Task OnTenantReadyAsync()
    {
        await LoadAsync();
        _members = await Organizations.GetMembersAsync();
        if (_issue is not null)
        {
            var project = await Projects.GetByKeyAsync(_issue.ProjectKey);
            _sprints = await SprintSvc.GetForProjectAsync(project.Id);
        }
    }

    private async Task LoadAsync()
    {
        _issue = await Issues.GetAsync(IssueId);
        _edit = new UpdateIssueRequest
        {
            Title = _issue.Title,
            Description = _issue.Description,
            Type = _issue.Type,
            Priority = _issue.Priority,
            AssigneeUserId = _issue.AssigneeUserId,
            StoryPoints = _issue.StoryPoints,
            SprintId = _issue.SprintId,
            DueDate = _issue.DueDate,
        };
        _descriptionDirty = false;
        StateHasChanged();
    }

    /// <summary>
    /// True when the Summary/Description editors differ from what's stored. Description dirtiness is
    /// tracked by a flag rather than string comparison: the editor's HTML and the sanitised HTML that
    /// comes back from the server are equivalent but not byte-identical, which would read as always-dirty.
    /// </summary>
    private bool IsDirty => _issue is not null && (_edit.Title != _issue.Title || _descriptionDirty);

    private void ResetEdits()
    {
        if (_issue is null) return;
        _edit.Title = _issue.Title;
        _edit.Description = _issue.Description;
        _descriptionDirty = false;
    }

    private void OnDescriptionChanged(string? html)
    {
        _edit.Description = html;
        _descriptionDirty = true;
        StateHasChanged(); // keeps the dirty indicator and Save button in step
    }

    /// <summary>
    /// Images dropped into the description are stored as ordinary issue attachments, so they inherit the
    /// same tenant + permission checks as any other file and need no separate upload endpoint.
    /// </summary>
    private async Task<string?> UploadInlineImageAsync(IBrowserFile file)
    {
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var saved = await Attachments.UploadAsync(IssueId, buffer, file.Name, file.ContentType, buffer.Length);
            await LoadAsync();
            return $"/{Slug}/attachments/{saved.Id}";
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            return null;
        }
    }

    private void CancelDescriptionEdit()
    {
        ResetEdits();
        _editingDescription = false;
    }

    private async Task SaveDetailsAsync()
    {
        if (!CanEditGeneral && !CanEditReporterFields) return;
        _saving = true;
        try
        {
            await Issues.UpdateAsync(IssueId, _edit);
            await LoadAsync();
            _editingDescription = false;
            Toasts.Success("Issue updated.");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _saving = false; }
    }

    /// <summary>Sidebar fields (priority, type, points, sprint) save immediately on change.</summary>
    private async Task SaveField(Action mutate)
    {
        if (!CanEditGeneral && !CanEditReporterFields) return;
        mutate();
        try
        {
            await Issues.UpdateAsync(IssueId, _edit);
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private async Task ChangeStatus(string? value)
    {
        if (!CanEditStatus || !Enum.TryParse<IssueStatus>(value, out var status)) return;
        try
        {
            await Issues.ChangeStatusAsync(IssueId, status);
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private async Task ChangeAssignee(string? userId)
    {
        if (!CanEditGeneral) return;
        try
        {
            await Issues.AssignAsync(IssueId, userId);
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private async Task AddViewer(string userId)
    {
        if (!CanEditGeneral) return;
        try
        {
            await Issues.AddViewerAsync(IssueId, userId);
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private async Task RemoveViewer(string userId)
    {
        if (!CanEditGeneral) return;
        try
        {
            await Issues.RemoveViewerAsync(IssueId, userId);
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    /// <summary>Comments are plain text (not the sanitised rich-text of a Description), so @mentions are
    /// highlighted at render time: everything else is HTML-encoded, only the @token spans are markup.</summary>
    private MarkupString RenderCommentBody(string body)
    {
        var sb = new StringBuilder();
        var cursor = 0;
        foreach (var (start, length, token) in Mentions.FindTokens(body))
        {
            sb.Append(HtmlEncoder.Default.Encode(body[cursor..start]));
            sb.Append("<span class=\"font-medium text-brand-600 dark:text-brand-400\">@")
              .Append(HtmlEncoder.Default.Encode(token))
              .Append("</span>");
            cursor = start + length;
        }
        sb.Append(HtmlEncoder.Default.Encode(body[cursor..]));
        return new MarkupString(sb.ToString());
    }

    private async Task AskAiAsync()
    {
        if (_asking || string.IsNullOrWhiteSpace(_aiQuestion)) return;
        _asking = true;
        try
        {
            _aiAnswerHtml = await Issues.AskAiAsync(IssueId, _aiQuestion);
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _asking = false; }
    }

    private async Task SaveAiNoteAsync()
    {
        if (_aiAnswerHtml is null || string.IsNullOrWhiteSpace(_aiQuestion)) return;
        _savingNote = true;
        try
        {
            await Issues.SaveAiNoteAsync(IssueId, _aiQuestion, _aiAnswerHtml);
            _aiAnswerHtml = null;
            _aiQuestion = null;
            await LoadAsync();
            Toasts.Success("Saved.");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _savingNote = false; }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;
        _commenting = true;
        try
        {
            await Issues.AddCommentAsync(new AddCommentRequest(IssueId, _newComment));
            _newComment = "";
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _commenting = false; }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            await Attachments.UploadAsync(IssueId, ms, file.Name, file.ContentType, ms.Length);
            Toasts.Success($"Attached {file.Name}.");
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _uploading = false; }
    }

    private async Task DeleteAttachmentAsync()
    {
        if (_confirmDeleteAttachmentId is not { } id) return;
        try
        {
            await Attachments.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _confirmDeleteAttachmentId = null; }
    }

    private async Task DeleteAsync()
    {
        await Issues.DeleteAsync(IssueId);
        Toasts.Success("Issue deleted.");
        Nav.NavigateTo($"/{Slug}/projects/{_issue!.ProjectKey}/board");
    }
}

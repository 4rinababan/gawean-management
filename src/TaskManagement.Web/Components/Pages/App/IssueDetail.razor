@page "/{Slug}/issues/{IssueId:guid}"
@using TaskManagement.Application.Services
@rendermode InteractiveServer
@layout OrgLayout
@attribute [Authorize]
@inherits OrgPageBase
@inject NavigationManager NavManager

<PageTitle>@(_reference ?? "Issue")</PageTitle>

@if (TenantReady)
{
    <IssueDetailPanel IssueId="IssueId" Slug="@Slug" ShowBreadcrumb="true" OnDeleted="OnDeleted" OnLoaded="OnLoaded" @key="IssueId" />
}
else
{
    <div class="flex justify-center py-16"><Spinner Class="h-8 w-8 text-brand-500" /></div>
}

@code {
    [Parameter] public Guid IssueId { get; set; }

    private string? _reference;
    private string? _projectKey;

    private void OnLoaded(IssueDetailDto issue)
    {
        _reference = issue.Reference;
        _projectKey = issue.ProjectKey;
    }

    private void OnDeleted() => NavManager.NavigateTo($"/{Slug}/projects/{_projectKey}/board");
}

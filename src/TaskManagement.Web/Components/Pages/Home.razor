@page "/"
@inject NavigationManager Nav

@{
    var origin = new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority);
    var ogImage = $"{origin}/og-image.png";
}

<PageTitle>GaweAn — Task &amp; project management for teams</PageTitle>

<HeadContent>
    <meta name="description" content="GaweAn is a task and project management tool for teams — Kanban boards, backlog grooming, sprint planning, burndown charts and workflow automation rules, free to start." />
    <link rel="canonical" href="@origin/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="GaweAn — Task &amp; project management for teams" />
    <meta property="og:description" content="Kanban boards, backlog, sprints, burndown charts and automation rules — in one place, free to start." />
    <meta property="og:url" content="@origin/" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="GaweAn — Task &amp; project management for teams" />
    <meta name="twitter:description" content="Kanban boards, backlog, sprints, burndown charts and automation rules — in one place, free to start." />
    <meta name="twitter:image" content="@ogImage" />
</HeadContent>

<section class="py-10 sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl">
            Kelola tugas tim, rapi dari backlog sampai selesai
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
            Board, backlog, sprint, dan automation rule dalam satu tempat &mdash; sederhana untuk tim kecil
            maupun organisasi.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <a href="/dashboard"><Button>Go to your dashboard</Button></a>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Register"><Button>Get started free</Button></a>
                    <a href="Account/Login"><Button Variant="Button.ButtonVariant.Secondary">Sign in</Button></a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-4 sm:grid-cols-2">
        <Card>
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200">
                    <Icon Name="squares" Class="h-5 w-5" />
                </span>
                <div>
                    <h2 class="font-semibold text-slate-900 dark:text-slate-100">Kanban board</h2>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Drag tugas antar kolom status, lihat progres tim secara real-time.</p>
                </div>
            </div>
        </Card>
        <Card>
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200">
                    <Icon Name="flag" Class="h-5 w-5" />
                </span>
                <div>
                    <h2 class="font-semibold text-slate-900 dark:text-slate-100">Backlog &amp; sprint</h2>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Susun backlog, rencanakan sprint, dan pantau burndown chart tiap iterasi.</p>
                </div>
            </div>
        </Card>
        <Card>
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200">
                    <Icon Name="rocket" Class="h-5 w-5" />
                </span>
                <div>
                    <h2 class="font-semibold text-slate-900 dark:text-slate-100">Automation rules</h2>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Otomatiskan pekerjaan berulang: pindah status, assign, dan notifikasi otomatis.</p>
                </div>
            </div>
        </Card>
        <Card>
            <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200">
                    <Icon Name="users" Class="h-5 w-5" />
                </span>
                <div>
                    <h2 class="font-semibold text-slate-900 dark:text-slate-100">Workspace tim</h2>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Undang anggota, atur peran, dan kelola beberapa proyek dalam satu workspace.</p>
                </div>
            </div>
        </Card>
    </div>
</section>

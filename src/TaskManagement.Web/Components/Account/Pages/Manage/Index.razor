@page "/Account/Manage"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using TaskManagement.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ProfileService Profile
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthState

<PageTitle>Profile</PageTitle>

<h1 class="mb-1 text-xl font-semibold text-slate-900 dark:text-slate-100">Profile</h1>
<p class="mb-6 text-sm text-slate-500 dark:text-slate-400">Your photo and contact details.</p>
<StatusMessage />

<Card>
    <div class="flex items-center gap-4">
        <Avatar Name="@(user?.DisplayName ?? username)" Color="@user?.AvatarColor" UserId="@user?.Id" Size="lg" Class="!h-16 !w-16 !text-xl" />
        <div>
            <div class="flex items-center gap-2">
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                    @if (_uploading)
                    {
                        <Spinner Class="h-4 w-4" />
                    }
                    else
                    {
                        <Icon Name="photo" Class="h-4 w-4" />
                    }
                    @(_uploading ? "Uploading…" : "Change photo")
                    <InputFile OnChange="OnAvatarSelectedAsync" class="sr-only" accept="image/png,image/jpeg,image/webp,image/gif" disabled="@_uploading" />
                </label>
                @if (user?.AvatarStorageKey is not null)
                {
                    <button type="button" class="text-xs text-rose-500 hover:underline" @onclick="RemoveAvatarAsync" disabled="@_uploading">Remove</button>
                }
            </div>
            <p class="mt-1.5 text-xs text-slate-400">JPEG, PNG, WEBP or GIF. Max 5 MB.</p>
        </div>
    </div>
</Card>

<Card Class="mt-4">
    <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3 text-xs text-rose-500" />
        <div class="space-y-4">
            <Field Label="Username">
                <input type="text" value="@username" class="tm-input" disabled />
            </Field>
            <Field Label="Phone number">
                <InputText @bind-Value="Input.PhoneNumber" class="tm-input" placeholder="Enter your phone number" />
                <ValidationMessage For="() => Input.PhoneNumber" class="mt-1 block text-xs text-rose-500" />
            </Field>
        </div>
        <div class="mt-6">
            <Button Type="submit">Save</Button>
        </div>
    </EditForm>
</Card>

@code {
    private ApplicationUser? user;
    private string? username;
    private string? phoneNumber;
    private bool _uploading;

    // Nullable, not the usual "= default!": unlike a static SSR page, this one is interactive, so it
    // can be re-initialized on a circuit reconnect (e.g. the browser drops the SignalR connection
    // mid-upload and reattaches) — that path carries no HTTP request, so no cascaded HttpContext.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // AuthenticationStateProvider stays valid across a reconnect; HttpContext doesn't, so user
        // resolution goes through it instead of HttpContext.User.
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        user = await UserManager.GetUserAsync(principal);
        if (user is null)
        {
            if (HttpContext is not null)
                RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);

        Input.PhoneNumber ??= phoneNumber;
    }

    private async Task OnAvatarSelectedAsync(InputFileChangeEventArgs e)
    {
        if (user is null) return;

        var file = e.File;
        _uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            await Profile.UpdateAvatarAsync(user.Id, ms, file.Name, file.ContentType);
            user = await UserManager.FindByIdAsync(user.Id);
            Toasts.Success("Profile photo updated.");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _uploading = false; }
    }

    private async Task RemoveAvatarAsync()
    {
        if (user is null) return;

        try
        {
            await Profile.RemoveAvatarAsync(user.Id);
            user = await UserManager.FindByIdAsync(user.Id);
            Toasts.Success("Profile photo removed.");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            if (HttpContext is not null)
                RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                if (HttpContext is not null)
                    RedirectManager.RedirectToCurrentPageWithStatus("Error: Failed to set phone number.", HttpContext);
                else
                    Toasts.Error("Failed to set phone number.");
                return;
            }
        }

        await SignInManager.RefreshSignInAsync(user);
        if (HttpContext is not null)
            RedirectManager.RedirectToCurrentPageWithStatus("Your profile has been updated", HttpContext);
        else
            Toasts.Success("Your profile has been updated.");
    }

    private sealed class InputModel
    {
        [Phone]
        [Display(Name = "Phone number")]
        public string? PhoneNumber { get; set; }
    }
}

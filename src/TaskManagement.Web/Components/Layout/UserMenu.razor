@namespace TaskManagement.Web.Components.Layout
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthState
@inject IUserDirectory Users
@inject IJSRuntime JS

<DropdownMenu>
    <Trigger>
        <button type="button" class="flex items-center gap-2 rounded-lg p-1 hover:bg-slate-100 dark:hover:bg-slate-800">
            <Avatar Name="@_name" Color="@_color" Size="sm" />
        </button>
    </Trigger>
    <ChildContent>
        <div class="border-b border-slate-100 px-3 py-2 dark:border-slate-700">
            <p class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">@_name</p>
            <p class="truncate text-xs text-slate-400">@_email</p>
        </div>
        <MenuItem Icon="🎨" OnClick="ToggleTheme">Toggle theme</MenuItem>
        <a href="Account/Manage" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-700">⚙️ Account settings</a>
        <form action="Account/Logout" method="post" class="border-t border-slate-100 dark:border-slate-700">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="" />
            <button type="submit" class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-rose-600 hover:bg-slate-100 dark:hover:bg-slate-700">↪ Sign out</button>
        </form>
    </ChildContent>
</DropdownMenu>

@code {
    private string _name = "Account";
    private string _email = "";
    private string _color = "#64748b";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _name = user.Identity?.Name ?? "Account";
        _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? _name;

        // Prefer the profile display name over the login (which is the email address).
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is not null && await Users.GetAsync(userId) is { } profile)
        {
            _name = profile.DisplayName;
            _email = profile.Email;
            _color = profile.AvatarColor;
            return;
        }

        _color = TaskManagement.Infrastructure.Identity.ApplicationUser.PickAvatarColor(_name);
    }

    private async Task ToggleTheme() => await JS.InvokeVoidAsync("tm.toggleTheme");
}

@namespace TaskManagement.Web.Components.Layout
@inherits LayoutComponentBase
@layout MainLayout
@inject TenantResolver TenantResolver
@inject ITenantContext Tenant
@inject NavigationManager Nav

@if (_state == State.Loading)
{
    <div class="flex justify-center py-24"><Spinner Class="h-8 w-8 text-brand-500" /></div>
}
else if (_state is State.Denied or State.Missing)
{
    <EmptyState Icon="@(_state == State.Denied ? "lock-closed" : "magnifying-glass")"
                Title="@(_state == State.Denied ? "You don't have access to this workspace" : "Workspace not found")"
                Description="@(_state == State.Denied
                    ? "Ask an administrator to invite you, or switch to a workspace you belong to."
                    : "The workspace URL doesn't match anything we have.")">
        <Actions><a href="/dashboard"><Button>Back to your workspaces</Button></a></Actions>
    </EmptyState>
}
else
{
    @* Sidebar is a slide-over below lg, a fixed column from lg up. *@
    <OrgMobileNav Slug="@Slug" />

    <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-8">
        <aside class="hidden lg:block">
            <div class="sticky top-20">
                <OrgSidebar Slug="@Slug" />
            </div>
        </aside>
        <div class="min-w-0">@Body</div>
    </div>
}

@code {
    private enum State { Loading, Ready, Denied, Missing }
    private State _state = State.Loading;

    private string Slug => Nav.ToBaseRelativePath(Nav.Uri).Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    protected override async Task OnParametersSetAsync()
    {
        var slug = Slug;
        if (string.IsNullOrEmpty(slug))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        _state = await TenantResolver.ResolveAsync(slug) switch
        {
            TenantResolver.Outcome.Resolved => State.Ready,
            TenantResolver.Outcome.NotAMember => State.Denied,
            TenantResolver.Outcome.NotFound => State.Missing,
            _ => State.Denied,
        };
    }
}

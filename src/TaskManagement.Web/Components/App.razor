<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
    <link rel="stylesheet" href="@Assets["lib/highlight/hljs-themes.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.generated.css"]" />
    <link rel="stylesheet" href="@Assets["TaskManagement.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        // Apply the saved theme before first paint to avoid a flash.
        (function () {
            try {
                var t = localStorage.getItem('tm-theme');
                if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }
            } catch (e) { }
        })();
    </script>
    <HeadOutlet />
</head>

<body class="h-full">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["lib/sortablejs/Sortable.min.js"]"></script>
    <script src="@Assets["lib/quill/quill.js"]"></script>
    @* highlight.js is small and used on every issue page; mermaid (2.5 MB) is loaded on demand
       by richcontent.js, only when a description actually contains a diagram. *@
    <script src="@Assets["lib/highlight/highlight.min.js"]"></script>
    <script src="@Assets["lib/signalr/signalr.min.js"]"></script>
    <script src="@Assets["lib/qrcode/qrcode.min.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/tour.js"]"></script>
    <script src="@Assets["js/qr.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        Blazor.addEventListener('enhancedload', () => {
            // Enhanced navigation replaces the <html> attributes with the server's, dropping the theme class.
            window.tm.restoreTheme();
            // …and swaps the body, so anything rendered imperatively has to be rebuilt.
            window.tmRenderQrCode?.();
        });
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

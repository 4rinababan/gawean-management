@namespace TaskManagement.Web.Components.Ui

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        @if (Breadcrumb is not null)
        {
            <div class="mb-1 text-xs font-medium text-slate-400">@Breadcrumb</div>
        }
        <h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="flex items-center gap-2">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}

@namespace TaskManagement.Web.Components.Ui

@* A headline number. Status tone is always paired with an icon and a label, never colour alone. *@
<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center gap-2">
        <span class="@($"flex h-7 w-7 shrink-0 items-center justify-center rounded-lg {IconClass}")">
            <Icon Name="@Icon" Class="h-4 w-4" />
        </span>
        <span class="truncate text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">@Label</span>
    </div>
    <p class="mt-3 text-3xl font-semibold tabular-nums text-slate-900 dark:text-slate-100">@Value</p>
    @if (Caption is not null)
    {
        <p class="mt-1 text-xs text-slate-400">@Caption</p>
    }
</div>

@code {
    /// <summary>Semantic tone. Status tones map to the reserved good/warning/critical roles.</summary>
    public enum Tone { Neutral, Info, Good, Warning, Critical }

    [Parameter, EditorRequired] public string? Label { get; set; }
    [Parameter, EditorRequired] public int Value { get; set; }
    /// <summary>Name of an <see cref="Ui.Icon"/> illustrating the metric.</summary>
    [Parameter] public string Icon { get; set; } = "check-circle";
    [Parameter] public string? Caption { get; set; }
    [Parameter] public Tone Color { get; set; } = Tone.Neutral;

    private string IconClass => Color switch
    {
        Tone.Info => "bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300",
        Tone.Good => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300",
        Tone.Warning => "bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300",
        Tone.Critical => "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300",
    };
}

@namespace TaskManagement.Web.Components.Ui

@* Same as DropdownMenu: close via a transparent backdrop, not @onfocusout, so option clicks land. *@
<div class="relative">
    <div class="tm-select flex min-h-[2.375rem] flex-wrap items-center gap-1.5">
        @if (Selected is not null)
        {
            @* Selection reads as a removable chip rather than plain text. *@
            <span class="inline-flex max-w-full items-center gap-1.5 rounded-full bg-brand-50 py-0.5 pl-0.5 pr-1 text-xs font-medium text-brand-800 dark:bg-brand-900/50 dark:text-brand-100">
                <Avatar Name="@Selected.DisplayName" Color="@Selected.AvatarColor" Size="xs" />
                <span class="truncate">@Selected.DisplayName</span>
                @if (AllowUnassigned)
                {
                    <button type="button" class="rounded-full px-1 leading-none text-brand-500 hover:bg-brand-100 hover:text-brand-800 dark:hover:bg-brand-800"
                            title="@($"Remove {Selected.DisplayName}")" aria-label="@($"Remove {Selected.DisplayName}")"
                            @onclick="() => Pick(null)" @onclick:stopPropagation="true">✕</button>
                }
            </span>
            <button type="button" class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-300"
                    @onclick="() => _open = !_open">Change</button>
        }
        else
        {
            <button type="button" class="flex-1 text-left text-slate-400" @onclick="() => _open = !_open">@Placeholder</button>
        }
    </div>

    @if (_open)
    {
        <div class="fixed inset-0 z-20" @onclick="() => _open = false"></div>
        <div class="absolute z-30 mt-1 max-h-64 w-full overflow-auto rounded-lg border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-800">
            <input class="tm-input mx-2 my-1 !w-[calc(100%-1rem)]" placeholder="Search people…"
                   @bind="_filter" @bind:event="oninput" />
            @if (AllowUnassigned)
            {
                <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-700"
                        @onclick="() => Pick(null)">
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-200 text-xs dark:bg-slate-600">∅</span>
                    Unassigned
                </button>
            }
            @foreach (var m in Filtered)
            {
                <button type="button" class="flex w-full items-center gap-2 px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-700"
                        @onclick="() => Pick(m.UserId)" @key="m.UserId">
                    <Avatar Name="@m.DisplayName" Color="@m.AvatarColor" Size="xs" />
                    <span class="truncate">@m.DisplayName</span>
                </button>
            }
            @if (!Filtered.Any())
            {
                <p class="px-3 py-2 text-sm text-slate-400">No matches.</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OrganizationMemberDto> Members { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select a person";
    [Parameter] public bool AllowUnassigned { get; set; } = true;

    private bool _open;
    private string _filter = "";

    private OrganizationMemberDto? Selected => Members.FirstOrDefault(m => m.UserId == Value);

    private IEnumerable<OrganizationMemberDto> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? Members
        : Members.Where(m => m.DisplayName.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                             || m.Email.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private async Task Pick(string? userId)
    {
        _open = false;
        Value = userId;
        await ValueChanged.InvokeAsync(userId);
    }
}

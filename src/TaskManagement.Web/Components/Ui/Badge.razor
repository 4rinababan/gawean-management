@namespace TaskManagement.Web.Components.Ui

<span class="@($"inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium {ColorClass} {Class}")">
    @ChildContent
</span>

@code {
    public enum BadgeColor { Slate, Brand, Green, Amber, Rose, Blue, Purple }

    [Parameter] public BadgeColor Color { get; set; } = BadgeColor.Slate;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ColorClass => Color switch
    {
        BadgeColor.Brand => "bg-brand-100 text-brand-700 dark:bg-brand-900/50 dark:text-brand-200",
        BadgeColor.Green => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-200",
        BadgeColor.Amber => "bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-200",
        BadgeColor.Rose => "bg-rose-100 text-rose-700 dark:bg-rose-900/50 dark:text-rose-200",
        BadgeColor.Blue => "bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-200",
        BadgeColor.Purple => "bg-purple-100 text-purple-700 dark:bg-purple-900/50 dark:text-purple-200",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300",
    };
}

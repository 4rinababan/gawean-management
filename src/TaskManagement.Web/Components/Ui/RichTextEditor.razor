@namespace TaskManagement.Web.Components.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Quill editor. The HTML it produces is sanitised server-side before it is stored — see
   RichTextSanitizer — so nothing here is trusted just because it came from our own toolbar. *@
<div class="tm-richtext @(ReadOnly ? "tm-richtext--readonly" : "")">
    <div @ref="_host"></div>
</div>

@if (!ReadOnly)
{
    @* Snippets: Quill's own code-block button gives an empty block, which is a poor start for a
       query or an ERD. These insert a working skeleton the author edits in place. *@
    <div class="mt-2 flex flex-wrap gap-2">
        <button type="button" class="tm-snippet" @onclick="() => InsertSnippet(SqlSkeleton)">
            <Icon Name="clipboard" Class="h-3.5 w-3.5" /> SQL query
        </button>
        <button type="button" class="tm-snippet" @onclick="() => InsertSnippet(CodeSkeleton)">
            <Icon Name="clipboard" Class="h-3.5 w-3.5" /> Code block
        </button>
        <button type="button" class="tm-snippet" @onclick="() => InsertSnippet(ErdSkeleton)">
            <Icon Name="squares" Class="h-3.5 w-3.5" /> ERD diagram
        </button>
    </div>
}

@if (!ReadOnly)
{
    @* Hidden on purpose: Quill's toolbar image button triggers this through JS interop, so uploads
       reuse the authenticated attachment pipeline instead of a bespoke JS upload endpoint. *@
    <div class="hidden">
        <InputFile @ref="_fileInput" OnChange="OnImageSelectedAsync" accept="image/*" />
    </div>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Uploads a pasted/inserted image and returns the URL to embed, or null to cancel.</summary>
    [Parameter] public Func<IBrowserFile, Task<string?>>? OnUploadImage { get; set; }

    private ElementReference _host;
    private InputFile? _fileInput;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RichTextEditor>? _ref;
    private string? _lastPushed;
    private bool _initialised;

    /// <summary>
    /// Render once and never again. Quill replaces this element's DOM with its own (and inserts a
    /// toolbar as a sibling), so letting Blazor diff over it on every parent re-render — which happens
    /// on each keystroke, because the value flows up to the page — steals focus and eats input.
    /// External value changes are pushed through JS in <see cref="OnParametersSetAsync"/> instead.
    /// </summary>
    protected override bool ShouldRender() => !_initialised;

    protected override async Task OnParametersSetAsync()
    {
        // Only push down changes that came from outside (a reload after save, or Discard) — never echo our own.
        if (_initialised && _module is not null && Value != _lastPushed)
        {
            _lastPushed = Value;
            await _module.InvokeVoidAsync("setContent", _host, Value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _ref = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/richtext.js");
        await _module.InvokeVoidAsync("create", _host, _ref, Value, ReadOnly);
        _lastPushed = Value;
        _initialised = true;
    }

    [JSInvokable]
    public async Task OnContentChangedAsync(string? html)
    {
        _lastPushed = html;
        Value = html;
        await ValueChanged.InvokeAsync(html);
    }

    private const string SqlSkeleton = """
        SELECT t.id, t.name
        FROM   table_name t
        WHERE  t.status = 'active'
        ORDER  BY t.name;
        """;

    private const string CodeSkeleton = """
        // paste your code here
        """;

    /// <summary>
    /// A Mermaid entity-relationship diagram. Rendered on the view side by richcontent.js; the block
    /// must start with "erDiagram" for that pass to recognise it.
    /// </summary>
    private const string ErdSkeleton = """
        erDiagram
            CUSTOMER ||--o{ ORDER : places
            ORDER    ||--|{ ORDER_LINE : contains
            PRODUCT  ||--o{ ORDER_LINE : "appears in"

            CUSTOMER {
                int    id PK
                string name
                string email
            }
            ORDER {
                int  id PK
                int  customer_id FK
                date placed_on
            }
        """;

    private async Task InsertSnippet(string snippet)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("insertCodeBlock", _host, snippet);
    }

    [JSInvokable]
    public async Task PickImageAsync()
    {
        if (_fileInput?.Element is { } element)
            await JS.InvokeVoidAsync("tm.click", element);
    }

    private async Task OnImageSelectedAsync(InputFileChangeEventArgs e)
    {
        if (OnUploadImage is null || _module is null)
            return;

        var url = await OnUploadImage(e.File);
        if (!string.IsNullOrEmpty(url))
            await _module.InvokeVoidAsync("insertImage", _host, url);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _host);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _ref?.Dispose();
    }
}

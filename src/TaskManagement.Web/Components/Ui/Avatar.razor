@namespace TaskManagement.Web.Components.Ui

<span class="@($"relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full font-semibold text-white {SizeClass} {Class}")"
      style="background-color: @(Color ?? "#64748b")"
      title="@Name">
    @Initials
    @if (!string.IsNullOrEmpty(UserId))
    {
        @* Stacked on top of the initials via the parent's overflow-hidden + this being absolutely
           positioned: a loaded photo fully covers them, and onerror just removes itself so a user
           with no uploaded photo (a 404 from /avatars/{id}) silently falls back to the initials. *@
        <img src="@($"/avatars/{UserId}")" alt=""
             class="absolute inset-0 h-full w-full object-cover"
             onerror="this.remove()" />
    }
</span>

@code {
    [Parameter, EditorRequired] public string? Name { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? UserId { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? Class { get; set; }

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name)) return "?";
            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..1].ToUpperInvariant(),
                _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
            };
        }
    }

    private string SizeClass => Size switch
    {
        "xs" => "h-6 w-6 text-[10px]",
        "sm" => "h-7 w-7 text-xs",
        "lg" => "h-12 w-12 text-base",
        _ => "h-9 w-9 text-sm",
    };
}

@namespace TaskManagement.Web.Components.Ui
@rendermode InteractiveServer
@implements IDisposable
@inject ToastService Toasts

<div class="pointer-events-none fixed bottom-4 right-4 z-[60] flex w-80 flex-col gap-2">
    @foreach (var toast in Toasts.Current)
    {
        <div class="@($"pointer-events-auto flex items-start gap-2 rounded-lg border px-4 py-3 text-sm shadow-lg {Style(toast.Level)}")"
             role="status" @key="toast.Id">
            <span class="flex-1">@toast.Message</span>
            <button type="button" class="opacity-60 hover:opacity-100" @onclick="() => Toasts.Dismiss(toast.Id)" aria-label="Dismiss">✕</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static string Style(ToastLevel level) => level switch
    {
        ToastLevel.Success => "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-200",
        ToastLevel.Warning => "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200",
        ToastLevel.Error => "border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-800 dark:bg-rose-950 dark:text-rose-200",
        _ => "border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200",
    };

    public void Dispose() => Toasts.Changed -= OnChanged;
}

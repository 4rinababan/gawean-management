# Copy to .env on the VPS and fill in the secrets. Never commit the real .env.

# Container image. The CD workflow builds this tag locally on the VPS's self-hosted runner and
# exports it before deploying; this value is only used for manual `docker compose` commands.
IMAGE=gawean-management:latest

# Public hostname and the email Let's Encrypt uses for expiry notices.
DOMAIN=gawean.web.id
TLS_EMAIL=admin@gawean.web.id

# PostgreSQL — set POSTGRES_PASSWORD to a long random string.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=taskmanagement

# SMTP (leave SMTP_HOST blank to disable email; links are written to the container logs instead)
SMTP_HOST=mail.ryugasolusindo.com
SMTP_PORT=465
SMTP_SECURITY=SslOnConnect        # SslOnConnect for port 465, StartTls for 587, or Auto
SMTP_USER=noreply@ryugasolusindo.com
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=noreply@ryugasolusindo.com
SMTP_FROM_NAME=GaWeAn

# AI drafting (optional). Any OpenAI-compatible /chat/completions endpoint; leave AI_API_KEY blank
# to turn the feature off entirely — the app then runs with no AI entry points in the UI.
# Note that issue text is sent to this endpoint, so confirm that is acceptable for your data first.
AI_ENDPOINT=https://api.biznetgio.ai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# S3-compatible object storage for attachments (optional). Leave S3_BUCKET blank to keep storing
# attachments on this VPS's local disk (the "uploads" volume) — fill all four in to switch to the
# bucket instead; works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OAuth (optional). Redirect URIs to register with each provider:
#   Google : https://gawean.web.id/signin-google
#   GitHub : https://gawean.web.id/signin-github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

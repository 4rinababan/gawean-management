# Copy to .env on the VPS and fill in. Never commit the real .env.

# Container image built by CI (the cd.yml workflow overrides IMAGE with the exact SHA tag).
IMAGE=ghcr.io/OWNER/taskmanagement:latest

# Public hostname and the email Let's Encrypt uses for expiry notices.
DOMAIN=tasks.example.com
TLS_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=taskmanagement

# SMTP (leave SMTP_HOST blank to disable email; links are written to the container logs instead)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURITY=SslOnConnect   # SslOnConnect for port 465, StartTls for 587, or Auto
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Taskflow

# OAuth (optional). Redirect URIs:
#   Google : https://tasks.example.com/signin-google
#   GitHub : https://tasks.example.com/signin-github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
